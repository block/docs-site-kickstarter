---
interface Props {
  type?: 'stars' | 'forks' | 'followers';
  repo?: string;
  account?: string;
  size?: 'default' | 'sm' | 'lg';
}

const { type = 'stars', repo, account, size = 'default' } = Astro.props;

let count = 0;
let label = '';
let icon = '';

try {
  if (type === 'followers' && account) {
    const res = await fetch(`https://api.github.com/users/${account}`);
    if (res.ok) {
      const data = await res.json();
      count = data.followers || 0;
    }
    label = 'followers';
    icon = 'users';
  } else if (repo) {
    const res = await fetch(`https://api.github.com/repos/${repo}`);
    if (res.ok) {
      const data = await res.json();
      count = type === 'forks' ? (data.forks_count || 0) : (data.stargazers_count || 0);
    }
    label = type === 'forks' ? 'forks' : 'stars';
    icon = type === 'forks' ? 'fork' : 'star';
  }
} catch {
  count = 0;
}

function formatCount(n: number): string {
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
  return n.toString();
}

const sizeClasses = {
  sm: 'github-stats-sm',
  default: 'github-stats-default',
  lg: 'github-stats-lg',
};
---

<span class={`github-stats ${sizeClasses[size]}`}>
  {icon === 'star' && (
    <svg class="github-stats-icon" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 19.771l-7.416 3.642 1.48-8.279L0 9.306l8.332-1.151z" />
    </svg>
  )}
  {icon === 'fork' && (
    <svg class="github-stats-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 3v6m0 0a3 3 0 103 3V9m-3 3a3 3 0 10-3 3m12-6v6m0 0a3 3 0 103 3v-3m-3 3a3 3 0 10-3 3" />
    </svg>
  )}
  {icon === 'users' && (
    <svg class="github-stats-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2m8-10a4 4 0 100-8 4 4 0 000 8zm6 2a3 3 0 100-6" />
    </svg>
  )}
  <span class="github-stats-count">{formatCount(count)}</span>
  <span class="github-stats-label">{label}</span>
</span>

<style>
  .github-stats {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-white);
    font-weight: 500;
  }

  .github-stats-icon {
    width: 1rem;
    height: 1rem;
    color: var(--sl-color-gray-3);
  }

  .github-stats-count {
    font-weight: 700;
  }

  .github-stats-label {
    color: var(--sl-color-gray-3);
  }

  .github-stats-sm {
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
  }

  .github-stats-sm .github-stats-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .github-stats-lg {
    font-size: 1.125rem;
    padding: 0.75rem 1.25rem;
  }

  .github-stats-lg .github-stats-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
